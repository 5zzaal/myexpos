type
    student{
        str name;
        int marks;
}
endtype

decl
    student s;
enddecl

int main(){
    decl
        int val;
    enddecl
    begin
        val=initialize();
        s=alloc();
        s.name="John";
        s.marks=89;
        val=exposcall("Write",-2,s.name);
        val=exposcall("Write",-2,s.marks);
        return 0;
    end
}