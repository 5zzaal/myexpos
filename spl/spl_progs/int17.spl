alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 9] = INT_LOGIN;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11]* 512 - 1;

alias returnAdd R1;
alias userName R2;
alias passWord R3;

//return add,passward(i/p),username(i/p)
returnAdd = [PTBR + 2*(userSP - 1)/512]*512 + (userSP - 1)%512;
passWord = [[PTBR + 2*(userSP - 3)/512]*512 + (userSP - 3)%512];
userName = [[PTBR + 2*(userSP - 4)/512]*512 + (userSP - 4)%512];

// Login process has PID = 1 
if([SYSTEM_STATUS_TABLE + 1] != 1)then
    [returnAdd] = -2;
    goto exit;
endif;

//get  User Table entry 
alias userTableEntry R4;
userTableEntry = 0;
while(userTableEntry < MAX_USER_NUM && [USER_TABLE + 2*userTableEntry] != userName)do
    userTableEntry = userTableEntry + 1;
endwhile;

//if such name doesnt exist
if(userTableEntry == MAX_USER_NUM)then
    [returnAdd] = -1;
    goto exit;
endif;


//encrypt the passwrd
encrypt passWord;


//if passwrd didnt match with usertable
if([USER_TABLE + 2*userTableEntry + 1] != passWord)then
    [returnAdd] = -1;
    goto exit;
endif;

//set the state and userid in process table for shell
[PROCESS_TABLE + 2*16 + 4] = CREATED;
[PROCESS_TABLE + 2*16 + 3] = userTableEntry;

//set state of current process
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 4] = WAIT_PROCESS;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 5] = 2;

//set in system status table
[SYSTEM_STATUS_TABLE] = userTableEntry;

//invoke scheduler
multipush(R0, R1, R2, R3, R4);
call MOD_5;
multipop(R0, R1, R2, R3, R4);


exit: 
	SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;