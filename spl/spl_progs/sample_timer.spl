//assg2 add breakpoint start and end of timer
breakpoint;
//user stackptr at 13 th word  backup current proceess in kerenl
[PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13] = SP;

//setting userpage to userpgnum*512-1
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11] * 512 - 1;

//bring the user contents to kernel using backup
backup;
//print "TIMER";


//save the context of running proceess

alias currentPID R0;
currentPID = [SYSTEM_STATUS_TABLE+1];

alias process_table_entry R1;
process_table_entry = PROCESS_TABLE + currentPID * 16;
[process_table_entry + 12] = SP % 512;
[process_table_entry + 14] = PTBR;
[process_table_entry + 15] = PTLR;
[process_table_entry + 4] = READY;

//scheduling algo we switch the process using %3{two process even odd then idle}
alias newPID R2;
newPID=(currentPID+1)%3;


//update register with new processcontext
alias new_process_table R3;
new_process_table = PROCESS_TABLE + newPID * 16;

//Set back Kernel SP, PTBR , PTLR
SP =  [new_process_table + 11] * 512 + [new_process_table + 12] ;
PTBR = [new_process_table + 14];
PTLR = [new_process_table + 15];

[SYSTEM_STATUS_TABLE + 1] = newPID;

//if created proceess has no history to remember and thus no user context to be restored before scheduled
//update new process states
if([new_process_table + 4] == CREATED) then
	[new_process_table + 4] = RUNNING;
	SP = [new_process_table + 13];
	ireturn;
endif;

[new_process_table + 4] = RUNNING;

//restore user context from kernel stack
restore;

//getback the sp
SP = [PROCESS_TABLE + ( [SYSTEM_STATUS_TABLE + 1] * 16) + 13];

//assg to print
//print [SYSTEM_STATUS_TABLE + 1];
breakpoint;

ireturn;