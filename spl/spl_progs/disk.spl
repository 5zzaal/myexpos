breakpoint;
//switch to kernel stack and backup
[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+13]=SP;
SP=[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+11]-1;

backup;

[DISK_STATUS_TABLE+0]=0;

alias counter R6;
counter=0;
while(counter<16)do
    if([PROCESS_TABLE+(counter*16)+4]==WAIT_DISK)then
        [PROCESS_TABLE+(counter*16)+4]=READY;
    endif;
    counter=counter+1;
endwhile;

restore;

breakpoint;
SP=[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+13];


// stage22 - assg
[DISK_STATUS_TABLE + 5] = [DISK_STATUS_TABLE + 5] + 1;

ireturn;