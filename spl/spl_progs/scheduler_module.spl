//Obtain the PID of the current process from the System Status Table 

alias currentPID R0;
currentPID=[SYSTEM_STATUS_TABLE+1];

//Push the BP of the current process on top of the kernel stack
multipush(BP);

//Process Table entry corresponding to the current process
alias process_table_entry R1;
process_table_entry =PROCESS_TABLE+currentPID*16;
[process_table_entry+12]=SP%512;
[process_table_entry+14]=PTBR;
[process_table_entry+15]=PTLR;

//Iterate through the Process Table entries
alias newPID R2;
alias next_entry R3;
alias curr R4;
alias found R5;
found=0;
curr=(currentPID+1)%16;
while(curr!=currentPID)do
    if([PROCESS_TABLE+curr*16+4]==CREATED ||[PROCESS_TABLE+curr*16+4]==READY)then
        newPID=curr;
        found=1;
        break;
    endif;
    curr=(curr+1)%16;
endwhile;

//setting  idle next process
if(found==0)then
    newPID=0;
endif;

//set SP as (User Area Page number) * 512 + (Kernel Stack pointer value)
next_entry=PROCESS_TABLE+newPID*16;
SP=([next_entry+11]*512)+[next_entry+12];
PTBR=[next_entry+14];
PTLR=[next_entry+15];

[SYSTEM_STATUS_TABLE+1]=newPID;

//new process is in CREATED state Switch to the user mode using the ireturn
if([next_entry+4]==CREATED)then
    SP=[next_entry+13];
    [next_entry+4]= RUNNING;
    [next_entry+9]=0;
    ireturn;
endif;

[next_entry+4]=RUNNING;
multipop(BP);

//Return using return statement
return;