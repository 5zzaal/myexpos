alias funcname R1;
alias currentPID R2;

if(funcname==8)then
    while([TERMINAL_STATUS_TABLE]==1)do
        [PROCESS_TABLE+(currentPID*16)+4]=WAIT_TERMINAL;

        multipush(R1,R2);
        call MOD_5;
        multipop(R1,R2);
    endwhile;
 
    [TERMINAL_STATUS_TABLE]=1;
    [TERMINAL_STATUS_TABLE+1]=currentPID;

    breakpoint;
    return;

endif;


if(funcname==9)then
    if([TERMINAL_STATUS_TABLE+1]!=currentPID)then
        R0=-1;
        return;
    endif;

    [TERMINAL_STATUS_TABLE]=0;

    alias proceess_index R4;
    proceess_index=1;
    while(proceess_index<16)do
        if([PROCESS_TABLE+(16*proceess_index)+4]==WAIT_TERMINAL)then
            [PROCESS_TABLE+(16*proceess_index)+4]=READY;
        endif;
        proceess_index=proceess_index+1;
    endwhile;

    R0=0;

    breakpoint;
    return;

endif;
