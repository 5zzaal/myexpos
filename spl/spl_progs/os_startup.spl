//load timer
loadi(4,17);
loadi(5,18);

//load library
loadi(63,13);
loadi(64,14);

//load init program
loadi(65,7);
loadi(66,8);

//load idle program
loadi(69,11);
loadi(70,12);

//load int10
loadi(22,35);
loadi(23,36);

//load init7
loadi(16,29);
loadi(17,30);

//load exhandler
loadi(2, 15);
loadi(3, 16);

//pagetable

//pagetable for idle
 PTBR = PAGE_TABLE_BASE;
 PTLR = 10;
//lib
[PTBR+0] = 63;
[PTBR+1] ="0100";
[PTBR+2] = 64;
[PTBR+3] ="0100";

//heap
[PTBR+4] =-1;
[PTBR+5] ="0000";
[PTBR+6] =-1;
[PTBR+7] ="0000";

//code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = 70;
[PTBR+11] = "0100";
[PTBR+12] =-1;
[PTBR+13] ="0000";
[PTBR+14] =-1;
[PTBR+15] ="0000";

//stack
[PTBR+16] = 81;
[PTBR+17] = "0110";
[PTBR+18] =-1;
[PTBR+19] ="0000";

//pagetable for init
 PTBR = PAGE_TABLE_BASE+20;

//lib
[PTBR+0] = 63;
[PTBR+1] ="0100";
[PTBR+2] = 64;
[PTBR+3] ="0100";

//heap
[PTBR+4] =78;
[PTBR+5] ="0110";
[PTBR+6] =79;
[PTBR+7] ="0110";

//code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] =-1;
[PTBR+13] ="0000";
[PTBR+14] =-1;
[PTBR+15] ="0000";

//stack
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] =77;
[PTBR+19] ="0110";


//process table setup

//processtable for idle

//82 as userpage
[PROCESS_TABLE + 11] = 82;

//pid
[PROCESS_TABLE + 1] = 0;

//uptr
[PROCESS_TABLE + 13] = 8*512;

//kptr
[PROCESS_TABLE + 12] = 0;

//ptbr
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE;

//ptlr
[PROCESS_TABLE + 15] = 10;

//state
[PROCESS_TABLE + 4] = CREATED;

//processtable for init

//userpagearea
[PROCESS_TABLE + 16 + 11] = 80;

//pid
[PROCESS_TABLE + 16 ] = 1;

//uptr
[PROCESS_TABLE + 16 + 13] = 8*512;

//kptr
[PROCESS_TABLE + 16 + 12] = 0;

//ptbr
[PROCESS_TABLE + 16 + 14] = PAGE_TABLE_BASE+20;

//ptlr
[PROCESS_TABLE + 16 + 15] = 10;

//state
[PROCESS_TABLE + 16 + 4] = RUNNING;


//65*512 :makes it reach first code region first is header second bit is entry pint so +1
//push ip to init process stack
[76*512] = [65*512+1];

//push ip to idle process stack
[81*512]=[69*512+1];


//setting up machine registers to do init
PTBR = PAGE_TABLE_BASE + 20;
PTLR=10;
SP = 8*512;

//update system status table
[SYSTEM_STATUS_TABLE + 1] = 1;

ireturn; 