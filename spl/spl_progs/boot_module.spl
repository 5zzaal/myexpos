loadi(8,21);
loadi(9,22);

//load disk interrupt
loadi(6,19);
loadi(7,20);


//load mod0:resource module
loadi(40,53);
loadi(41,54);

//load mod1:process manager
loadi(42,55);
loadi(43,56);

//load mod2:memory manager
loadi(44,57);
loadi(45,58);


//load mod4:device module
loadi(48,61);
loadi(49,62);


//load mod5:scheduler
loadi(50,63);
loadi(51,64);


//load inode and usertable
loadi(59,3);
loadi(60,4);


//pagetable for init
 PTBR = PAGE_TABLE_BASE+20;
 PTLR=10;

//lib
[PTBR+0] = 63;
[PTBR+1] ="0100";
[PTBR+2] = 64;
[PTBR+3] ="0100";

//heap
[PTBR+4] =78;
[PTBR+5] ="0110";
[PTBR+6] =79;
[PTBR+7] ="0110";

//code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] =-1;
[PTBR+13] ="0000";
[PTBR+14] =-1;
[PTBR+15] ="0000";

//stack
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] =77;
[PTBR+19] ="0110";



//processtable for init

//userpagearea
[PROCESS_TABLE + 16 + 11] = 80;

//pid
[PROCESS_TABLE + 16+1] = 1;

//uptr
[PROCESS_TABLE + 16 + 13] = 8*512;

//kptr
[PROCESS_TABLE + 16 + 12] = 0;

//ptbr
[PROCESS_TABLE + 16 + 14] = PAGE_TABLE_BASE+20;

//ptlr
[PROCESS_TABLE + 16 + 15] = 10;

//state
[PROCESS_TABLE + 16 + 4] = CREATED;



//initalise per process resourcetable
alias resourcetable R1;
resourcetable=80*512+RESOURCE_TABLE_OFFSET;
R9=0;
while(R9<16)do
    [resourcetable+R9]=-1;
    R9=R9+1;
endwhile;


// disk map table initialise 
R9 = 0;
while(R9 < 10) do
    [DISK_MAP_TABLE + 10 + R9] = -1;
    R9 = R9 + 1;
endwhile;



//65*512 :makes it reach first code region first is header second bit is entry pint so +1
//push ip to init process stack
[76*512] = [65*512+1];


//setting state of all pid (other than first 3) to terminated

alias currentPID R0;
currentPID=2;
while(currentPID<16)do
    [PROCESS_TABLE+(currentPID*16)+4]=TERMINATED;
    currentPID=currentPID+1;
endwhile;



[TERMINAL_STATUS_TABLE]=0;


//initalise memory memory freelist

alias currpage R0;
currpage=0;


while(currpage<=82)do
    [MEMORY_FREE_LIST+currpage]=1;
    currpage=currpage+1;
endwhile;

alias freepage R1;
freepage=0;


while(currpage<=127)do
    [MEMORY_FREE_LIST+currpage]=0;
    currpage=currpage+1;
    freepage=freepage+1;
endwhile;

//memfree(freepages) and memwait count(blocked)
[SYSTEM_STATUS_TABLE+2]=freepage;
[SYSTEM_STATUS_TABLE+3]=0;


//disk status table
[DISK_STATUS_TABLE+0]=0;


//return from module to os startup
return;