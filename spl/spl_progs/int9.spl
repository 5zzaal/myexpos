//mode flag
[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+9]=9;

//save usersp
alias userSP R0;
userSP=SP;

[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+13]=SP;
SP=[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+11]*512-1;

alias filename R1;
filename=[[PTBR+(2*((userSP-4)/512))]*512+((userSP-4)%512)];

//search for filename 
alias inode_index R2;
inode_index=0;
while(inode_index<MAX_FILE_NUM)do
    if([INODE_TABLE+(16*inode_index)+1]==filename)then 
        break;
    endif;
    inode_index=inode_index+1;
endwhile;

//no file founded
if(inode_index >= MAX_FILE_NUM || [INODE_TABLE + (16*inode_index) + 0] != EXEC) then
    alias physicalAddrRetVal R3;
    physicalAddrRetVal = [PTBR + (2 * ((userSP-1)/512))] * 512 + ((userSP-1) % 512);
    [physicalAddrRetVal] = -1;
    ireturn;
endif;

//call exit process
multipush(R0,R1,R2);
R1=3;
R2=[SYSTEM_STATUS_TABLE+1];
call MOD_1;
multipop(R0,R1,R2);

//userarea page
alias userAreaPage R3;
userAreaPage=[PROCESS_TABLE+(16*[SYSTEM_STATUS_TABLE+1])+11];
[MEMORY_FREE_LIST+userAreaPage]=[MEMORY_FREE_LIST+userAreaPage]+1;
[SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]-1;

SP=userAreaPage*512-1;

//resetting perprocess resource table
alias resourcetable R8;
resourcetable = userAreaPage * 512 + RESOURCE_TABLE_OFFSET;
R9=0;
while(R9<16)do
    [resourcetable+R9]=-1;
    R9=R9+1;
endwhile;

//process table
[PROCESS_TABLE + (16 * [SYSTEM_STATUS_TABLE+1]) + 4] = RUNNING; //READY?
[PROCESS_TABLE + (16 * [SYSTEM_STATUS_TABLE+1]) + 7] = inode_index;

//pagetable
PTBR=PAGE_TABLE_BASE+([SYSTEM_STATUS_TABLE+1]*20);

[PTBR+0]=63;
[PTBR+1]="0100";
[PTBR+2]=64;
[PTBR+3]="0100";


//invalidating heap
[PTBR + 4] = -1;
[PTBR + 5] = "0000";
[PTBR + 6] = -1;
[PTBR + 7] = "0000";



//stack
multipush(R0,R1,R2,R3);

R1=1;
call MOD_2;
[PTBR+16]=R0;
[PTBR+17]="0110";

R1=1;
call MOD_2;
[PTBR+18]=R0;
[PTBR+19]="0110";
multipop(R0,R1,R2,R3);


//checking inode and getcodepg
if([INODE_TABLE + inode_index*16 + 8] != -1)then
    multipush(R0, R1, R2, R3);
    R1 = GET_CODE_PAGE;
    R2 = [INODE_TABLE + inode_index*16 + 8];
    call MOD_2;
    [PTBR + 8] = R0;
    [PTBR + 8 + 1] = "0100";
    multipop(R0, R1, R2, R3);
else   
    [PTBR + 8] = -1;
    [PTBR + 8 + 1] = "0000";
endif;


//invalidate rest of the code

alias counter R4;
counter = 5;
while(counter<8)do
    [PTBR + 2*counter] = -1;
    [PTBR + 2*counter + 1] = "0000";
    counter = counter + 1;
endwhile;



//initalize diskmap code pages setted as disk blocknum
counter = 0;
while(counter < 10)do
    if(counter>3 && counter<8)then
        [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1]*10 + counter] = [INODE_TABLE + inode_index*16 + 8 + counter - 4];
    else
        [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1]*10 + counter] = -1;
    endif;
    counter = counter + 1;
endwhile;



//push ip to userstacktop
[[PTBR+16]*512]=[[PTBR+8]*512+1];
SP=8*512;


//return success
alias physicalAddrRetVal R3;
physicalAddrRetVal = [PTBR + (2 * ((userSP-1)/512))] * 512 + ((userSP-1) % 512);
[physicalAddrRetVal] = 0;

//mode flag reset
[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+9]=0;


ireturn;
