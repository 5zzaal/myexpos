alias userSP R0;
userSP = SP;

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 13] = SP;
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11]* 512 - 1;

alias sysNum R1;
alias returnAdd R2;
alias userName R3;

sysNum = [[PTBR + 2*(userSP - 5)/512] * 512 + (userSP - 5)%512];
userName = [[PTBR + 2*(userSP - 4)/512]*512 + (userSP - 4)%512];
returnAdd = [PTBR + 2*(userSP - 1)/512]*512 + (userSP - 1)%512;

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 9] = sysNum;




//if syscall is newuser
if(sysNum == INT_NEWUSR)then

    alias passWord R4;
    passWord = [[PTBR + 2*(userSP - 3)/512]*512 + (userSP - 3)%512];

    //If the current user is not root, or if the current process is not the shell
    if([SYSTEM_STATUS_TABLE] != 1 || [SYSTEM_STATUS_TABLE + 1] != 2)then
        [returnAdd] = -2;
        goto exit;
    endif;
    

    //loop through and exit if an entry exist
    alias userTableEntry R5;
    userTableEntry = 0;
    while(userTableEntry < MAX_USER_NUM)do
        if([USER_TABLE + 2*userTableEntry] == userName)then
            [returnAdd] = -1;
            goto exit;
        endif;
        userTableEntry = userTableEntry + 1;
    endwhile;


//Find a free entry in the User Table
    userTableEntry = 0;
    while(userTableEntry <MAX_USER_NUM && [USER_TABLE + 2*userTableEntry] != -1)do
        userTableEntry = userTableEntry + 1;
    endwhile;


// If no free entry is found
    if(userTableEntry == MAX_USER_NUM)then
        [returnAdd] = -3;
        goto exit;
    endif;


//Find the encrypted password by applying the ENCRYPT instruction 
    encrypt passWord;

    [USER_TABLE + 2*userTableEntry] = userName;
    [USER_TABLE + 2*userTableEntry + 1] = passWord;

    [returnAdd] = 0;
endif;




//syscall is remove user
if(sysNum == INT_REMUSR)then
    
    //If the current user is not root, or if the current process is not the shell or root /kernel
    if([SYSTEM_STATUS_TABLE] != 1 || [SYSTEM_STATUS_TABLE + 1] != 2 || userName == "root" || userName == "kernal")then
        [returnAdd] = -2;
        goto exit;
    endif;

    //loop and find the entry
    alias userTableEntry R4;
    userTableEntry = 0;
    while(userTableEntry <MAX_USER_NUM && [USER_TABLE + 2*userTableEntry] != userName)do
        userTableEntry = userTableEntry + 1;
    endwhile;   


    //if not found return -1
    if(userTableEntry == MAX_USER_NUM)then
        [returnAdd] = -1;
        goto exit;
    endif;  

    //Loop through the Root File and exit returning -3 if there are files of the user present on disk.
    alias userFiles R5;
    userFiles = 0;
    while(userFiles < MAX_FILE_NUM)do
        if([ROOT_FILE + 8*userFiles + 3] == userName)then
            [returnAdd] = -3;
            goto exit;
        endif;
        userFiles = userFiles + 1;
    endwhile;

    //invalidate entry by setting to -1
    [USER_TABLE + 2*userTableEntry] = -1;
    [USER_TABLE + 2*userTableEntry + 1] = -1;

    [returnAdd] = 0;
endif;




//syscall is setpwd
if(sysNum == INT_SETPWD)then
    
    //if current process is not shell
    if([SYSTEM_STATUS_TABLE + 1] != 2)then
        [returnAdd] = -1;
        goto exit;
    endif;

    alias passWord R4;
    passWord = [[PTBR + 2*(userSP - 3)/512]*512 + (userSP - 3)%512];

//loop through and find username entry
    alias userTableEntry R5;
    userTableEntry = 0;
    while(userTableEntry < MAX_USER_NUM && [USER_TABLE + 2*userTableEntry] != userName)do
        userTableEntry = userTableEntry + 1;
    endwhile;

    if(userTableEntry == MAX_USER_NUM)then
        [returnAdd] = -2;
        goto exit;
    endif;

//if userid of the process is not equal to the userid of the user and  current user is not root
    if([SYSTEM_STATUS_TABLE] != userTableEntry && [SYSTEM_STATUS_TABLE] != ROOT)then
        if(userTableEntry != 1)then
            [returnAdd] = -1;
            goto exit;
        endif;
    endif;

//find the encrypted pswd
    encrypt passWord;

//set the pswd
    [USER_TABLE + 2*userTableEntry + 1] = passWord;

    [returnAdd] = 0;
endif;




//syscall is getuser id
if(sysNum == INT_GETUID)then

    alias userTableEntry R4;
    userTableEntry = 0;

    //loop through the table with username
    while(userTableEntry < MAX_USER_NUM)do
        if([USER_TABLE + 2*userTableEntry] == userName)then
            [returnAdd] = userTableEntry;
            goto exit;
        endif;
        userTableEntry = userTableEntry + 1;
    endwhile;

    [returnAdd] = -1;
endif;




//syscall is getusername
if(sysNum == INT_GETUNAME)then
    alias userId R4;
    userId = [[PTBR + 2*(userSP - 4)/512]*512 + (userSP - 4)%512];

//if invalid userid return -1
    if(userId < 0 || userId > 15 || [USER_TABLE + 2*userId] == -1)then
        [returnAdd] = -1;
        goto exit;
    endif;

//else find the correct entry in usertable and username
    [returnAdd] = [USER_TABLE + 2*userId];
endif;


exit: 
	SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
	[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

ireturn;